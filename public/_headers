# Vite 构建产物带哈希，可长期强缓存
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff
  Cache-Control: public, max-age=31536000, immutable

# 图片/视频文件名不带哈希，短缓存 + 后台更新，兼顾速度与可替换
/assets/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.mp4
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
